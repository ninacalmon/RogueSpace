;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="rogue-space"
run/main_scene="uid://3en43s0xvhci"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Globals="*res://globals.gd"
EventBus="*res://event_bus.gd"
SFXManager="*res://sfx_manager.gd"
LevelTransition="*res://level_transition.tscn"
PowerUps="*res://power_ups.gd"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="rogue-space"

[editor_plugins]

enabled=PackedStringArray("res://addons/tile_to_scene/plugin.cfg")

[global_group]

Player_Group=""

